# Selects the configured model provider.
MODEL_PROVIDER=

# Claude API provider credentials and model selection.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BOUNDARY_MODEL=

# Local model fallback command.
LOCAL_MODEL_COMMAND=

# Runtime storage and model-work settings.
DATABASE_PATH=
MODEL_MAX_CONCURRENCY=

# Optional messaging intake integration.
MESSAGING_BOT_TOKEN=
# Comma-separated messaging sender IDs permitted to use the bot.
MESSAGING_ALLOWED_SENDERS=

# Optional Gmail intake poller (OAuth client that minted the refresh token).
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Optional simulated RazorpayX payout-request preparation capability.
RAZORPAYX_COMPANY_ACCOUNT_NUMBER=
